# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Supabase (or any Postgres) connection string, "Transaction pooler" URI from
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://user:password@host:port/dbname

# Apify: Console -> Settings -> Integrations -> Personal API token
APIFY_TOKEN=

# Anthropic API key for post categorization (console.anthropic.com -> API Keys)
# This is separate from any Claude Code / claude.ai subscription.
ANTHROPIC_API_KEY=

# Max posts to request per account per weekly run (keeps Apify cost predictable)
MAX_POSTS_PER_RUN=20

# Max posts to request per account on the very first backfill run
BACKFILL_MAX_POSTS=40
